{
  "name": "delivery-service",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "delivery": "./dist/cli/main.js"
  },
  "description": "A deterministically gated agent delivery harness, with a delivery command",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorjives/delivery-service.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "test": "npm run lint && npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "demo:slice-1": "npx tsx demos/slice-1-round-trip.ts",
    "demo:gate-slice-1": "npx tsx demos/gate-interface-slice-1-delta-rule.ts",
    "demo:gate-slice-2": "npx tsx demos/gate-interface-slice-2-command-gate.ts",
    "demo:gate-slice-3": "npx tsx demos/gate-interface-slice-3-custom-gate.ts",
    "demo:gate-slice-4": "npx tsx demos/gate-interface-slice-4-resolution.ts",
    "demo:gate-slice-5": "npx tsx demos/gate-interface-slice-5-round-trip.ts",
    "demo:surface-slice-1": "npx tsx demos/single-surface-slice-1-provisioning.ts",
    "demo:surface-slice-2": "npx tsx demos/single-surface-slice-2-happy-path.ts",
    "demo:surface-slice-3": "npx tsx demos/single-surface-slice-3-setbacks.ts",
    "demo:surface-slice-4": "npx tsx demos/single-surface-slice-4-budgets.ts",
    "demo:surface-slice-5": "npx tsx demos/single-surface-slice-5-crash-recovery.ts",
    "demo:agent-slice-1": "npx tsx demos/agent-invocation-slice-1-worker-invocation.ts",
    "demo:agent-slice-2": "npx tsx demos/agent-invocation-slice-2-tool-authority.ts",
    "demo:agent-slice-3": "npx tsx demos/agent-invocation-slice-3-gate-maintenance.ts",
    "demo:triage-slice-1": "npx tsx demos/triage-slice-1-informed-retry.ts",
    "demo:triage-slice-2": "npx tsx demos/triage-slice-2-escalation-packets.ts",
    "demo:triage-slice-3": "npx tsx demos/triage-slice-3-last-attempt.ts",
    "demo:close-slice-1": "npx tsx demos/close-interface-slice-1-merge-back.ts",
    "demo:close-slice-2": "npx tsx demos/close-interface-slice-2-branch-and-teardown.ts",
    "demo:close-slice-3": "npx tsx demos/close-interface-slice-3-close-failure.ts",
    "demo:close-slice-4": "npx tsx demos/close-interface-slice-4-custom-closer.ts",
    "demo:close-slice-5": "npx tsx demos/close-interface-slice-5-open-pr.ts",
    "demo:mock-slice-1": "npx tsx demos/agent-mock-slice-1-honest-double.ts",
    "demo:mock-slice-3": "npx tsx demos/agent-mock-slice-3-scripted-pipeline.ts",
    "demo:mock-slice-4": "npx tsx demos/agent-mock-slice-4-misbehaving-agent.ts",
    "demo:report-slice-1": "npx tsx demos/observability-slice-1-report.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@jorj/claude-mock": "file:vendor/claude-mock",
    "@types/node": "^26.4.1",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "@inquirer/prompts": "^8.7.2",
    "commander": "^14.0.3",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.5.4"
  }
}
